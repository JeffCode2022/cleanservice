---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CleanMaster | Limpieza Profesional de Muebles, Cortinas y Tapicería a Domicilio",
  description = "Expertos en limpieza profunda de sofás, cortinas roller, sillas y colchones. Inyección-succión alemana, vapor 140°C y secado express en 2 horas. Productos bio-ecológicos."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="limpieza de muebles, lavado de sofás, cortinas roller, desinfección de colchones, limpieza de sillas, tapicería, inyección succión" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />
  </body>
</html>
