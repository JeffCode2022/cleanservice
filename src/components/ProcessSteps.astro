---
---
<section id="proceso" class="process-section full-bleed bg-slate-900 text-white overflow-hidden relative">
  <div class="h-screen w-full flex flex-nowrap process-container relative">
    
    <!-- Step 1 -->
    <div class="process-panel w-screen h-screen flex-shrink-0 flex items-center justify-center p-8 relative perspective-[1000px]">
      <div class="max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center panel-content" style="transform-origin: left center;">
        <div>
          <span class="font-display text-8xl md:text-9xl opacity-20 block mb-4">01</span>
          <h3 class="font-display text-4xl md:text-5xl font-bold mb-4 text-emerald-400">Reserva y Evaluación</h3>
          <p class="font-body text-lg text-slate-300">Contáctanos vía WhatsApp para agendar tu servicio. Realizamos una evaluación preliminar para entender tus necesidades específicas y preparar el equipo adecuado.</p>
        </div>
        <div class="rounded-2xl overflow-hidden glass-card p-2 bg-white/5 border border-white/10 shadow-2xl">
          <div class="aspect-square bg-slate-800 rounded-xl flex items-center justify-center">
             <svg class="w-32 h-32 text-sky-500 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="process-panel w-screen h-screen flex-shrink-0 flex items-center justify-center p-8 relative perspective-[1000px]">
      <div class="max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center panel-content" style="transform-origin: left center;">
        <div>
          <span class="font-display text-8xl md:text-9xl opacity-20 block mb-4">02</span>
          <h3 class="font-display text-4xl md:text-5xl font-bold mb-4 text-emerald-400">Inspección In Situ</h3>
          <p class="font-body text-lg text-slate-300">Nuestro equipo experto llega a tu domicilio y verifica el estado de tus muebles o alfombras, identificando manchas difíciles y el tipo de tela.</p>
        </div>
        <div class="rounded-2xl overflow-hidden glass-card p-2 bg-white/5 border border-white/10 shadow-2xl">
          <img src="/images/team-working.jpg" alt="Equipo trabajando" class="w-full aspect-square object-cover rounded-xl" />
        </div>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="process-panel w-screen h-screen flex-shrink-0 flex items-center justify-center p-8 relative perspective-[1000px]">
      <div class="max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center panel-content" style="transform-origin: left center;">
        <div>
          <span class="font-display text-8xl md:text-9xl opacity-20 block mb-4">03</span>
          <h3 class="font-display text-4xl md:text-5xl font-bold mb-4 text-emerald-400">Limpieza Profunda</h3>
          <p class="font-body text-lg text-slate-300">Aplicamos productos especializados y utilizamos maquinaria de inyección-extracción para remover polvo, ácaros y suciedad incrustada desde la raíz.</p>
        </div>
        <div class="rounded-2xl overflow-hidden glass-card p-2 bg-white/5 border border-white/10 shadow-2xl">
          <div class="aspect-square bg-slate-800 rounded-xl flex items-center justify-center">
             <svg class="w-32 h-32 text-sky-500 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 4 -->
    <div class="process-panel w-screen h-screen flex-shrink-0 flex items-center justify-center p-8 relative perspective-[1000px]">
      <div class="max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center panel-content" style="transform-origin: left center;">
        <div>
          <span class="font-display text-8xl md:text-9xl opacity-20 block mb-4">04</span>
          <h3 class="font-display text-4xl md:text-5xl font-bold mb-4 text-emerald-400">Secado y Acabado</h3>
          <p class="font-body text-lg text-slate-300">Aspiramos el exceso de humedad dejando tus muebles casi secos y con un aroma fresco. Realizamos una revisión final contigo para asegurar tu total satisfacción.</p>
        </div>
        <div class="rounded-2xl overflow-hidden glass-card p-2 bg-white/5 border border-white/10 shadow-2xl">
          <div class="aspect-square bg-slate-800 rounded-xl flex items-center justify-center">
             <svg class="w-32 h-32 text-emerald-500 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path></svg>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const container = document.querySelector('.process-container') as HTMLElement;
  const panels = gsap.utils.toArray('.process-panel');

  if (container && panels.length > 0) {
    const totalScrollWidth = container.scrollWidth - window.innerWidth;
    
    // Main horizontal scroll animation
    const scrollTween = gsap.to(panels, {
      xPercent: -100 * (panels.length - 1),
      ease: "none",
      scrollTrigger: {
        trigger: ".process-section",
        pin: true,
        scrub: 1,
        snap: 1 / (panels.length - 1),
        end: () => "+=" + container.offsetWidth
      }
    });

    // 3D effect on individual panels as they enter
    panels.forEach((panel: any) => {
      const content = panel.querySelector('.panel-content');
      if(content) {
        gsap.fromTo(content, 
          { 
            rotateY: 45, 
            opacity: 0,
            scale: 0.8
          },
          {
            rotateY: 0,
            opacity: 1,
            scale: 1,
            ease: "power2.out",
            scrollTrigger: {
              trigger: panel,
              containerAnimation: scrollTween,
              start: "left center",
              end: "center center",
              scrub: 1
            }
          }
        );
        gsap.to(content, {
            rotateY: -45,
            opacity: 0,
            scale: 0.8,
            ease: "power2.in",
            scrollTrigger: {
              trigger: panel,
              containerAnimation: scrollTween,
              start: "center center",
              end: "right center",
              scrub: 1
            }
        });
      }
    });
  }
</script>
