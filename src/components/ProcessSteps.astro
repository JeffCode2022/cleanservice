---
import ScrollExpand from './ScrollExpand.astro';

const steps = [
  {
    num: "01",
    phase: "Fase 1",
    title: "Diagnóstico & Percusión",
    desc: "Aspirado industrial por percusión profunda (3,200 rpm). Desaloja el 90% del polvo y ácaros antes de humedecer la tela.",
    img: "/images/team-working.jpg",
    metric: "230 mbar",
    accent: "Aspirado en Seco"
  },
  {
    num: "02",
    phase: "Fase 2",
    title: "Desmanchado Enzimático",
    desc: "Microespuma bio-vegetal de pH neutro 7.2. Disuelve manchas de café, vino y grasa sin decolorar ni quemar las fibras.",
    img: "/images/hero-cleaning.jpg",
    metric: "pH 7.2 Neutro",
    accent: "Bio-Vegetal"
  },
  {
    num: "03",
    phase: "Fase 3",
    title: "Inyección Térmica 140°C",
    desc: "Inyección de vapor a 4.5 bar y succión simultánea. Destruye el 99.9% de ácaros y alérgenos con grado clínico.",
    img: "/images/service-sofa.jpg",
    metric: "140°C Vapor",
    accent: "99.9% Desinfección"
  },
  {
    num: "04",
    phase: "Fase 4",
    title: "Turbosecado Express",
    desc: "Turbinas centrífugas de 3,500 m³/h. Evaporación acelerada para que disfrutes tus muebles limpios en solo 2 horas.",
    img: "/images/process-step4.jpg",
    metric: "2 Horas",
    accent: "Secado Rápido"
  }
];
---

<section id="proceso" class="full-bleed bg-slate-950 text-white relative">
  
  <!-- ScrollExpand Component: Expansión suave con ScrollTrigger -->
  <ScrollExpand
    src="/images/hero-cleaning.jpg"
    alt="Inyección-Succión Alemana"
    title="Ingeniería Textil"
    subtitle="El Método de Limpieza en 4 Fases"
    scrollHint="Desliza para expandir el laboratorio y ver el proceso"
    startWidth={50}
    startHeight={58}
    startRadius={32}
    endRadius={0}
    mediaZoom={1.35}
    overlayScrim={0.88}
  >
    
    <!-- Contenido del Método revelado en pantalla completa -->
    <div class="w-full max-w-6xl mx-auto py-4 sm:py-6 flex flex-col justify-center">
      
      <!-- Encabezado con ALTO CONTRASTE -->
      <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8">
        <span class="text-[11px] uppercase tracking-widest font-display text-sky-400 font-bold bg-sky-500/15 px-3 py-1 rounded-full border border-sky-400/30 inline-block mb-2">
          Protocolo Certificado CleanMaster
        </span>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-white tracking-tight drop-shadow-md">
          La Ciencia Detrás de Cada Fibra
        </h2>
        <p class="text-slate-300 text-xs sm:text-sm mt-2 leading-relaxed">
          Maquinaria alemana especializada para garantizar limpieza profunda sin maltratar tus tejidos.
        </p>
      </div>

      <!-- Cuadrícula 4 Fases con TARJETAS BLANCAS Y TEXTO OSCURO DE MÁXIMO CONTRASTE -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        {steps.map((step) => (
          <div class="group relative rounded-2xl overflow-hidden bg-white/95 backdrop-blur-xl border border-white p-4 flex flex-col justify-between hover:-translate-y-2 hover:shadow-[0_20px_35px_-10px_rgba(2,132,199,0.3)] transition-all duration-300 shadow-xl">
            
            <div>
              <!-- Imagen Real de la Fase -->
              <div class="relative h-36 sm:h-40 rounded-xl overflow-hidden mb-3.5 bg-slate-100 shadow-inner">
                <img 
                  src={step.img} 
                  alt={step.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                />
                <span class="absolute top-2.5 left-2.5 bg-slate-900/90 backdrop-blur text-sky-300 text-[10px] font-bold font-display px-2 py-0.5 rounded-md border border-slate-700 shadow">
                  {step.phase}
                </span>
                <span class="absolute bottom-2.5 right-2.5 bg-sky-600 text-white text-[11px] font-bold font-display px-2 py-0.5 rounded-md shadow">
                  {step.metric}
                </span>
              </div>

              <!-- Título & Número (COLOR NEGRO / SLATE OSCURO 100% LEGIBLE) -->
              <div class="flex items-center justify-between mb-1.5">
                <h3 class="font-display font-bold text-base sm:text-lg text-slate-900 group-hover:text-sky-600 transition-colors leading-tight">
                  {step.title}
                </h3>
                <span class="font-display font-extrabold text-slate-300 text-lg sm:text-xl">
                  {step.num}
                </span>
              </div>

              <!-- Descripción (TEXTO GRIS OSCURO LEGIBLE) -->
              <p class="text-slate-600 text-xs sm:text-[13px] leading-relaxed">
                {step.desc}
              </p>
            </div>

            <!-- Footer Card -->
            <div class="mt-4 pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-500 font-medium">{step.accent}</span>
              <span class="text-emerald-600 font-bold flex items-center gap-1">
                <span>✓</span> Certificado
              </span>
            </div>

          </div>
        ))}
      </div>

      <!-- CTA Inferior -->
      <div class="mt-8 text-center">
        <a 
          href="https://wa.me/51999999999?text=Hola%20CleanMaster,%20quiero%20agendar%20un%20servicio%20con%20el%20m%C3%A9todo%20en%204%20fases"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 bg-sky-500 hover:bg-sky-400 text-slate-950 font-display font-bold px-7 py-3 rounded-full shadow-lg shadow-sky-500/25 hover:scale-105 active:scale-95 transition-all text-xs sm:text-sm"
        >
          <span>Agendar Limpieza con Este Método</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>

  </ScrollExpand>

</section>
