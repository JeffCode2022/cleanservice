---
---

<section id="hero" class="relative w-full min-h-[95vh] pt-32 sm:pt-36 pb-16 overflow-hidden flex flex-col justify-between">
  
  <!-- Luz ambiental suave (Glow / Spotlight) -->
  <div class="absolute top-1/4 right-[10%] w-[650px] h-[500px] bg-gradient-to-br from-sky-200/40 via-sky-100/20 to-emerald-100/30 rounded-full blur-[130px] pointer-events-none -z-10"></div>
  <div class="absolute top-12 left-5 w-[400px] h-[400px] bg-sky-100/30 rounded-full blur-[110px] pointer-events-none -z-10"></div>

  <!-- Contenedor Full-Width (Layout Asimétrico Moderno) -->
  <div class="w-full max-w-[1440px] mx-auto px-5 sm:px-10 lg:px-14 flex-1 flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-8 relative z-10">
    
    <!-- COLUMNA IZQUIERDA: Tipografía Editorial y Conversión Directa -->
    <div class="w-full lg:w-[50%] flex flex-col justify-center space-y-6 sm:space-y-7 hero-text-col">
      
      <!-- Badge de Autoridad -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full glass-card border border-white/90 shadow-xs w-fit">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-xs font-bold text-slate-800 font-body-alt">
          Tecnología Alemana de Inyección-Succión
        </span>
        <span class="text-slate-300">|</span>
        <span class="text-xs font-semibold text-sky-600">Vapor a 140°C</span>
      </div>

      <!-- Titular Principal con Revelado GSAP -->
      <h1 class="font-display text-4xl sm:text-6xl xl:text-7xl font-bold tracking-tight text-slate-900 leading-[1.08] hero-heading">
        Devolvemos la vida <br class="hidden sm:inline"/>
        y pureza a tus <br class="hidden sm:inline"/>
        <span class="text-sky-600 relative inline-block">
          muebles y cortinas.
          <svg class="absolute -bottom-2 left-0 w-full h-3 text-sky-300 -z-10" viewBox="0 0 100 20" preserveAspectRatio="none">
            <path d="M0,15 Q50,0 100,15" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
          </svg>
        </span>
      </h1>

      <!-- Subtítulo -->
      <p class="text-slate-600 text-base sm:text-lg max-w-xl leading-relaxed hero-description">
        Eliminamos hasta el <strong class="text-slate-900 font-semibold">99.9% de manchas profundas, ácaros y malos olores</strong>. Secado express en solo 2 a 3 horas con fórmulas bio-ecológicas 100% seguras para niños y mascotas.
      </p>

      <!-- CTAs de Alta Conversión -->
      <div class="flex flex-wrap items-center gap-4 pt-2 hero-actions">
        <a 
          href="#cotizador" 
          class="relative overflow-hidden bg-sky-600 hover:bg-sky-500 text-white font-display font-bold text-sm sm:text-base px-8 py-4 rounded-full shadow-lg shadow-sky-600/25 hover:shadow-sky-600/40 hover:-translate-y-1 transition-all duration-300 active:scale-95 flex items-center gap-3 group"
        >
          <span class="relative z-10">Cotizar Servicio en 30 Seg</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 relative z-10 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
        </a>

        <a 
          href="#antes-despues" 
          class="glass-card hover:bg-white text-slate-800 font-display font-semibold text-sm sm:text-base px-7 py-4 rounded-full transition-all duration-300 flex items-center gap-2"
        >
          <span>Ver Antes / Después</span>
          <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
        </a>
      </div>

      <!-- Social Proof / Prueba Social -->
      <div class="pt-4 flex items-center gap-4 border-t border-slate-200/60 hero-proof">
        <div class="flex -space-x-2.5 overflow-hidden">
          <div class="inline-block h-9 w-9 rounded-full ring-2 ring-white bg-slate-200 flex items-center justify-center font-bold text-xs text-slate-700">M</div>
          <div class="inline-block h-9 w-9 rounded-full ring-2 ring-white bg-sky-200 flex items-center justify-center font-bold text-xs text-sky-800">C</div>
          <div class="inline-block h-9 w-9 rounded-full ring-2 ring-white bg-emerald-200 flex items-center justify-center font-bold text-xs text-emerald-800">J</div>
          <div class="inline-block h-9 w-9 rounded-full ring-2 ring-white bg-amber-200 flex items-center justify-center font-bold text-xs text-amber-800">V</div>
        </div>
        <div class="text-xs">
          <div class="flex items-center text-amber-400 gap-0.5">
            ★★★★★
            <span class="font-bold text-slate-900 ml-1.5 font-body-alt">4.9 / 5.0</span>
          </div>
          <p class="text-slate-500 text-[11px] font-medium">+1,400 sofás y cortinas renovados este año</p>
        </div>
      </div>

    </div>

    <!-- COLUMNA DERECHA: IMAGEN FLOTANTE SIN FONDO CON REBOTE ELÁSTICO Y SALIDA EN SCROLL -->
    <div class="w-full lg:w-[50%] relative flex items-center justify-center min-h-[420px] sm:min-h-[520px] perspective-container" id="heroVisualStage">
      
      <!-- Glow centrado detrás del sofá -->
      <div class="absolute w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] bg-radial from-sky-200/50 via-emerald-100/30 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>

      <!-- CONTENEDOR 3D FLOTANTE CON ENTRADA INDEPENDIENTE DE SCROLL -->
      <div id="heroEntranceWrapper" class="w-full max-w-[580px] relative">
        <div class="relative w-full hero-floating-cluster" id="heroCluster">
        
        <!-- Sofá de lujo aislado sin fondo -->
        <img 
          src="/images/sofa-float.png" 
          alt="Sofá de lujo impecable" 
          class="w-full h-auto object-contain select-none hero-sofa-img drop-shadow-[0_30px_35px_rgba(2,132,199,0.18)] drop-shadow-[0_12px_20px_rgba(0,0,0,0.06)]"
        />

        <!-- Herramienta de inyección-extracción flotando sobre el sofá -->
        <div class="absolute -top-6 -right-2 sm:-right-8 w-44 sm:w-56 hero-tool-float select-none pointer-events-none drop-shadow-[0_20px_25px_rgba(2,132,199,0.25)]">
          <img 
            src="/images/tool-float.png" 
            alt="Boquilla extractora de precisión" 
            class="w-full h-auto object-contain"
          />
        </div>

        <!-- BADGE FLOTANTE 1: 99.9% Desinfección -->
        <div class="absolute -top-4 -left-2 sm:-left-6 glass-card p-3 sm:p-3.5 rounded-2xl flex items-center gap-3 shadow-xl border border-white/95 hero-float-badge float-badge-1 select-none">
          <div class="w-9 h-9 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold text-sm shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <span class="block text-xs font-bold text-slate-900 font-display">99.9% Sanitización</span>
            <span class="text-[10px] text-slate-500 font-medium">Luz UV & Vapor 140°C</span>
          </div>
        </div>

        <!-- BADGE FLOTANTE 2: Secado en 2 Horas -->
        <div class="absolute -bottom-4 right-4 sm:right-6 glass-card p-3 sm:p-3.5 rounded-2xl flex items-center gap-3 shadow-xl border border-white/95 hero-float-badge float-badge-2 select-none">
          <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <span class="block text-xs font-bold text-slate-900 font-display">Secado en 2h</span>
            <span class="text-[10px] text-slate-500 font-medium">Turbinas Industriales</span>
          </div>
        </div>

        <!-- BADGE FLOTANTE 3: Fórmula Bio -->
        <div class="absolute bottom-16 -left-4 sm:-left-8 glass-card px-3.5 py-2 rounded-xl flex items-center gap-2 shadow-lg border border-white/95 hero-float-badge float-badge-3 select-none">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[11px] font-bold text-slate-800 font-body-alt">🌿 100% Inocuo Mascotas</span>
        </div>

      </div>
      </div>

    </div>

  </div>

  <!-- MARQUEE INFINITO INFERIOR (Confianza y Autoridad) -->
  <div class="w-full bg-slate-900 text-white py-4 overflow-hidden flex whitespace-nowrap mt-12 relative z-10 border-y border-slate-800">
    <div class="marquee-track flex items-center shrink-0">
      {['Inyección-Succión Alemana', 'Secado en 2 Horas', '99.9% Ácaros Eliminados', 'Fórmulas Bio-Ecológicas', 'Garantía 100% de Repaso', 'Personal con SCTR y DNI', 'Atención en Todo Lima'].map((item) => (
        <div class="flex items-center mx-6">
          <span class="text-xs sm:text-sm font-semibold uppercase tracking-wider font-display text-slate-200">{item}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 mx-6 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z" />
          </svg>
        </div>
      ))}
      {['Inyección-Succión Alemana', 'Secado en 2 Horas', '99.9% Ácaros Eliminados', 'Fórmulas Bio-Ecológicas', 'Garantía 100% de Repaso', 'Personal con SCTR y DNI', 'Atención en Todo Lima'].map((item) => (
        <div class="flex items-center mx-6">
          <span class="text-xs sm:text-sm font-semibold uppercase tracking-wider font-display text-slate-200">{item}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 mx-6 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z" />
          </svg>
        </div>
      ))}
    </div>
  </div>

</section>

<!-- Animaciones GSAP: Entrada elástica desde el costado y retroceso al hacer scroll -->
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initHero = () => {
    const entranceWrapper = document.getElementById('heroEntranceWrapper');
    const cluster = document.getElementById('heroCluster');
    const stage = document.getElementById('heroVisualStage');

    // 1. ANIMACIÓN DE ENTRADA AL CARGAR LA PÁGINA
    const entryTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // Texto izquierdo
    entryTl.fromTo('.hero-heading', 
      { y: 35, opacity: 0 },
      { y: 0, opacity: 1, duration: 1, ease: 'power3.out' }
    )
    .fromTo('.hero-description', 
      { y: 25, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8 }, 
      "-=0.6"
    )
    .fromTo('.hero-actions', 
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6 }, 
      "-=0.5"
    )
    .fromTo('.hero-proof', 
      { y: 15, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.5 }, 
      "-=0.4"
    );

    // SOFÁ Y CLUSTER: Aparece del costado derecho con rebote elástico
    if (entranceWrapper) {
      entryTl.fromTo(entranceWrapper, 
        {
          x: 350,
          opacity: 0,
          scale: 0.9,
          rotateY: -12
        },
        {
          x: 0,
          opacity: 1,
          scale: 1,
          rotateY: 0,
          duration: 1.6,
          ease: 'elastic.out(1, 0.6)'
        }, 
        "-=1.4"
      );
    }

    // Badges flotantes pop-in
    entryTl.fromTo('.hero-float-badge',
      { scale: 0, opacity: 0 },
      {
        scale: 1,
        opacity: 1,
        duration: 0.7,
        stagger: 0.12,
        ease: 'back.out(2)'
      },
      "-=0.9"
    );

    // 2. IDLE FLOATING ANIMATION (Inicia tras completarse la entrada)
    entryTl.add(() => {
      gsap.to('.hero-sofa-img', {
        y: -10,
        duration: 3,
        yoyo: true,
        repeat: -1,
        ease: 'sine.inOut'
      });

      gsap.to('.hero-tool-float', {
        y: -16,
        rotate: -3,
        duration: 2.8,
        yoyo: true,
        repeat: -1,
        ease: 'sine.inOut',
        delay: 0.2
      });

      gsap.to('.float-badge-1', {
        y: -8,
        duration: 3.2,
        yoyo: true,
        repeat: -1,
        ease: 'sine.inOut',
        delay: 0.3
      });

      gsap.to('.float-badge-2', {
        y: -12,
        duration: 2.6,
        yoyo: true,
        repeat: -1,
        ease: 'sine.inOut',
        delay: 0.5
      });

      gsap.to('.float-badge-3', {
        y: -6,
        duration: 3.5,
        yoyo: true,
        repeat: -1,
        ease: 'sine.inOut',
        delay: 0.1
      });
    });

    // 3. EFECTO SCROLL: Al scrollear hacia abajo sale suavemente a la derecha; al volver arriba regresa
    if (cluster) {
      gsap.to(cluster, {
        x: 240,
        opacity: 0,
        scale: 0.92,
        ease: 'power1.in',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom 20%',
          scrub: 1,
          invalidateOnRefresh: true
        }
      });
    }

    // 4. PARALLAX 3D REACT BITS: TILT SUTIL SEGÚN MOVIMIENTO DEL MOUSE
    if (stage && cluster) {
      stage.addEventListener('mousemove', (e) => {
        const rect = stage.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        gsap.to(cluster, {
          rotateY: x * 0.02,
          rotateX: -y * 0.02,
          duration: 0.5,
          ease: 'power1.out',
          transformPerspective: 1000,
          overwrite: 'auto'
        });
      });

      stage.addEventListener('mouseleave', () => {
        gsap.to(cluster, {
          rotateY: 0,
          rotateX: 0,
          duration: 0.7,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
