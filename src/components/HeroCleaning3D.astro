---

<section class="relative w-full h-auto min-h-screen pt-32 pb-16 overflow-hidden bg-slate-50">
  <div class="full-bleed flex flex-col lg:flex-row items-center w-full min-h-[80vh]">
    <!-- Left text -->
    <div class="w-full lg:w-[55%] edge-pad z-10 flex flex-col justify-center pb-12 lg:pb-0">
      <div class="space-y-6 max-w-3xl">
        <h1 class="hero-title text-5xl lg:text-7xl font-bold font-display text-slate-900 leading-[1.1]" style="clip-path: inset(100% 0 0 0);">
          Devolvemos la vida original a tus <span class="text-sky-600">muebles y cortinas</span>
        </h1>
        
        <p class="hero-subtext text-lg lg:text-xl text-slate-600 font-body-alt max-w-2xl" style="clip-path: inset(100% 0 0 0);">
          Servicio premium de limpieza profunda a domicilio. Eliminamos el 99.9% de ácaros, manchas difíciles y olores, dejando tus espacios impecables y saludables con secado rápido.
        </p>

        <div class="hero-buttons flex flex-wrap gap-4 pt-4 opacity-0">
          <a href="https://wa.me/51999999999" class="bg-sky-600 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-sky-700 hover:shadow-lg hover:shadow-sky-600/30 hover:-translate-y-1 transition-all duration-300 flex items-center gap-2">
            Cotizar por WhatsApp
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
               <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.573-.187-.981-.342-1.713-.64-2.825-2.39-2.91-2.505-.084-.114-.695-.923-.695-1.761 0-.838.435-1.25.59-1.42.144-.158.337-.215.466-.215.127 0 .252-.005.367 0 .13.006.314-.047.49.38.181.442.593 1.45.644 1.554.05.105.084.226.014.364-.069.138-.105.226-.208.347-.105.122-.218.261-.31.353-.105.104-.216.219-.095.428.12.209.539.892 1.157 1.439.803.71 1.472.932 1.68 1.037.208.105.333.088.457-.052.124-.14 0-.46.544-.64.693-.182.261.092.592.148.66.056.069.149.034.333-.092.405z"/>
            </svg>
          </a>
          <a href="#servicios" class="bg-white text-slate-900 px-8 py-4 rounded-full font-bold text-lg border border-slate-200 hover:border-slate-300 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            Ver Servicios
          </a>
        </div>

        <div class="pt-8 grid grid-cols-2 gap-4">
          <div class="trust-badge flex items-center gap-3 opacity-0 translate-y-4">
            <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-slate-800 font-medium font-body-alt">Inyección-Succión</span>
          </div>
          <div class="trust-badge flex items-center gap-3 opacity-0 translate-y-4">
            <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-slate-800 font-medium font-body-alt">Secado Rápido</span>
          </div>
          <div class="trust-badge flex items-center gap-3 opacity-0 translate-y-4">
            <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-slate-800 font-medium font-body-alt">Eco-amigables</span>
          </div>
          <div class="trust-badge flex items-center gap-3 opacity-0 translate-y-4">
            <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-slate-800 font-medium font-body-alt">Garantía 100%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Image -->
    <div class="w-full lg:w-[45%] h-[50vh] lg:h-[80vh] relative overflow-hidden rounded-l-[3rem] shadow-2xl ml-auto hero-image-container translate-x-[100px] opacity-0" style="perspective: 1000px;">
      <div class="hero-image-wrapper w-full h-full" style="transform: rotateY(-8deg);">
        <img src="/images/hero-cleaning.jpg" alt="Servicio de limpieza de muebles" class="w-full h-[120%] object-cover hero-image" />
      </div>
    </div>
  </div>
</section>

<!-- Marquee -->
<div class="w-full bg-slate-900 text-white py-4 overflow-hidden flex whitespace-nowrap">
  <div class="marquee-track flex items-center shrink-0">
    <!-- Items set 1 -->
    {['Inyección-Succión Alemana', 'Secado en 2 Horas', '99.9% Ácaros Eliminados', 'Productos Bio-Ecológicos', '100% Garantía de Satisfacción', 'Personal Uniformado'].map((item) => (
      <div class="flex items-center mx-6">
        <span class="text-sm font-semibold uppercase tracking-wider font-display">{item}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 mx-6 text-sky-500" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z" />
        </svg>
      </div>
    ))}
    <!-- Items set 2 for seamless loop -->
    {['Inyección-Succión Alemana', 'Secado en 2 Horas', '99.9% Ácaros Eliminados', 'Productos Bio-Ecológicos', '100% Garantía de Satisfacción', 'Personal Uniformado'].map((item) => (
      <div class="flex items-center mx-6">
        <span class="text-sm font-semibold uppercase tracking-wider font-display">{item}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 mx-6 text-sky-500" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z" />
        </svg>
      </div>
    ))}
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee 25s linear infinite;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Intro animation
  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  tl.to('.hero-title', {
    clipPath: 'inset(0% 0 0 0)',
    duration: 1.2,
    y: 0
  })
  .to('.hero-subtext', {
    clipPath: 'inset(0% 0 0 0)',
    duration: 1,
  }, "-=0.8")
  .to('.hero-buttons', {
    opacity: 1,
    y: 0,
    duration: 0.8
  }, "-=0.6")
  .to('.trust-badge', {
    opacity: 1,
    y: 0,
    duration: 0.6,
    stagger: 0.1
  }, "-=0.6")
  .to('.hero-image-container', {
    x: 0,
    opacity: 1,
    duration: 1.2,
    ease: 'power4.out'
  }, "-=1.5")
  .to('.hero-image-wrapper', {
    rotationY: 0,
    duration: 1.5,
    ease: 'power3.out'
  }, "-=1.2");

  // Parallax effect on image
  gsap.to('.hero-image', {
    yPercent: 20,
    ease: 'none',
    scrollTrigger: {
      trigger: '.hero-image-container',
      start: 'top bottom',
      end: 'bottom top',
      scrub: true
    }
  });
</script>
