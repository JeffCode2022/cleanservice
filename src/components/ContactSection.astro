---
---
<section id="contacto" class="contact-section full-bleed edge-pad bg-slate-900 text-white py-24 overflow-hidden relative">
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-16 relative z-10 perspective-1000">
    
    <div class="contact-left w-full lg:w-1/2 flex flex-col gap-8">
      <h2 class="font-display text-4xl lg:text-5xl font-bold text-white">
        Solicita tu Cotización
      </h2>
      <p class="text-slate-300 font-body text-lg">
        Déjanos tus datos y te enviaremos una cotización personalizada sin compromiso. Respondemos en minutos.
      </p>
      
      <div class="flex flex-col gap-6 mt-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold font-display text-white">WhatsApp</h4>
            <p class="text-slate-400 font-body-alt">+51 999 999 999</p>
          </div>
        </div>
        
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold font-display text-white">Cobertura</h4>
            <p class="text-slate-400 font-body-alt">Lima Metropolitana y Callao</p>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold font-display text-white">Horario de Atención</h4>
            <p class="text-slate-400 font-body-alt">Lunes a Domingo: 8:00 AM - 6:00 PM</p>
          </div>
        </div>
      </div>
    </div>
    
    <div class="contact-right w-full lg:w-1/2">
      <div class="glass-card bg-white p-8 rounded-2xl shadow-2xl">
        <form id="contact-form" class="flex flex-col gap-5">
          <div>
            <label for="name" class="block text-slate-700 font-bold font-display mb-1">Nombre</label>
            <input type="text" id="name" required class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all" placeholder="Tu nombre" />
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="phone" class="block text-slate-700 font-bold font-display mb-1">Teléfono</label>
              <input type="tel" id="phone" required class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all" placeholder="Tu número" />
            </div>
            <div>
              <label for="district" class="block text-slate-700 font-bold font-display mb-1">Distrito</label>
              <input type="text" id="district" required class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all" placeholder="Tu distrito" />
            </div>
          </div>
          
          <div>
            <label for="service" class="block text-slate-700 font-bold font-display mb-1">Servicio de interés</label>
            <select id="service" required class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all appearance-none">
              <option value="" disabled selected>Selecciona un servicio</option>
              <option value="Limpieza de Sofás">Limpieza de Sofás</option>
              <option value="Limpieza de Colchones">Limpieza de Colchones</option>
              <option value="Limpieza de Sillas">Limpieza de Sillas</option>
              <option value="Limpieza de Alfombras">Limpieza de Alfombras</option>
            </select>
          </div>

          <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-4 px-6 rounded-lg font-display text-lg transition-all duration-300 hover:scale-[1.02] shadow-lg hover:shadow-emerald-500/30 flex justify-center items-center gap-2 mt-2">
            <span>Enviar por WhatsApp</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".contact-section",
      start: "top 70%",
    }
  });

  tl.from(".contact-left", {
    x: -100,
    opacity: 0,
    rotateY: 10,
    duration: 1,
    ease: "power3.out"
  })
  .from(".contact-right", {
    x: 100,
    opacity: 0,
    rotateY: -10,
    duration: 1,
    ease: "power3.out"
  }, "-=0.8");

  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const phone = (document.getElementById('phone') as HTMLInputElement).value;
    const district = (document.getElementById('district') as HTMLInputElement).value;
    const service = (document.getElementById('service') as HTMLSelectElement).value;
    
    const message = `Hola CleanMaster, me llamo ${name}. Deseo cotizar el servicio de ${service} en el distrito de ${district}. Mi número es ${phone}.`;
    const whatsappUrl = `https://wa.me/51999999999?text=${encodeURIComponent(message)}`;
    
    window.open(whatsappUrl, '_blank');
  });
</script>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
</style>
