---
---

<header class="fixed top-4 left-0 right-0 z-50 transition-all duration-300 w-[95%] max-w-7xl mx-auto rounded-full glass-nav px-6 py-4 flex items-center justify-between shadow-lg" id="navbar">
  <div class="flex items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
    </svg>
    <a href="/" class="text-2xl font-bold font-display tracking-tight flex">
      <span class="text-slate-900">Clean</span><span class="text-sky-600">Master</span>
    </a>
  </div>
  
  <nav class="hidden md:flex items-center gap-8">
    <a href="#servicios" class="text-slate-900 font-medium relative group">
      Servicios
      <span class="absolute left-0 -bottom-1 w-0 h-0.5 bg-sky-600 transition-all duration-300 group-hover:w-full"></span>
    </a>
    <a href="#beneficios" class="text-slate-900 font-medium relative group">
      Beneficios
      <span class="absolute left-0 -bottom-1 w-0 h-0.5 bg-sky-600 transition-all duration-300 group-hover:w-full"></span>
    </a>
    <a href="#testimonios" class="text-slate-900 font-medium relative group">
      Testimonios
      <span class="absolute left-0 -bottom-1 w-0 h-0.5 bg-sky-600 transition-all duration-300 group-hover:w-full"></span>
    </a>
    
    <div class="flex items-center gap-2 bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-full text-sm font-medium border border-emerald-100">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      Disponibles Hoy
    </div>
  </nav>

  <div class="hidden md:flex">
    <a href="https://wa.me/51999999999" class="bg-sky-600 text-white px-6 py-2.5 rounded-full font-medium hover:bg-sky-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
      Cotizar Ahora
    </a>
  </div>

  <button id="mobile-menu-btn" class="md:hidden text-slate-900 focus:outline-none">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
    </svg>
  </button>
</header>

<div id="mobile-menu" class="fixed inset-0 z-40 bg-white/95 backdrop-blur-md hidden flex-col items-center justify-center gap-8 pt-20 transition-all duration-300 opacity-0 pointer-events-none">
  <button id="close-menu-btn" class="absolute top-6 right-6 text-slate-900">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <a href="#servicios" class="text-2xl font-bold text-slate-900 mobile-link">Servicios</a>
  <a href="#beneficios" class="text-2xl font-bold text-slate-900 mobile-link">Beneficios</a>
  <a href="#testimonios" class="text-2xl font-bold text-slate-900 mobile-link">Testimonios</a>
  <a href="https://wa.me/51999999999" class="bg-sky-600 text-white px-8 py-3 rounded-full font-bold text-lg mt-4 shadow-lg shadow-sky-600/30 mobile-link">Cotizar Ahora</a>
</div>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const closeMenuBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('py-2');
      navbar?.classList.remove('py-4');
    } else {
      navbar?.classList.add('py-4');
      navbar?.classList.remove('py-2');
    }
  });

  const toggleMenu = () => {
    mobileMenu?.classList.toggle('hidden');
    mobileMenu?.classList.toggle('flex');
    setTimeout(() => {
      mobileMenu?.classList.toggle('opacity-0');
      mobileMenu?.classList.toggle('pointer-events-none');
    }, 10);
  };

  mobileMenuBtn?.addEventListener('click', toggleMenu);
  closeMenuBtn?.addEventListener('click', toggleMenu);
  
  mobileLinks.forEach(link => {
    link.addEventListener('click', toggleMenu);
  });
</script>
