<script>
  // Executive Navbar & Mobile Drawer Controller
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileCloseBtn = document.getElementById('mobileMenuCloseBtn');
  const mobileDrawer = document.getElementById('mobileMenuDrawer');
  const mobileBackdrop = document.getElementById('mobileMenuBackdrop');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  const navBar1 = document.getElementById('navBar1');
  const navBar2 = document.getElementById('navBar2');
  const mainHeader = document.getElementById('mainHeader');
  const navbarInner = document.getElementById('navbarInner');

  function openDrawer() {
    if (!mobileDrawer || !mobileBackdrop) return;
    mobileDrawer.classList.remove('translate-x-full');
    mobileDrawer.classList.add('translate-x-0');
    mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
    mobileBackdrop.classList.add('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
    mobileBtn?.setAttribute('aria-expanded', 'true');

    if (navBar1 && navBar2) {
      navBar1.style.transform = 'translateY(4px) rotate(45deg)';
      navBar2.style.transform = 'translateY(-4px) rotate(-45deg)';
    }
  }

  function closeDrawer() {
    if (!mobileDrawer || !mobileBackdrop) return;
    mobileDrawer.classList.remove('translate-x-0');
    mobileDrawer.classList.add('translate-x-full');
    mobileBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
    mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
    mobileBtn?.setAttribute('aria-expanded', 'false');

    if (navBar1 && navBar2) {
      navBar1.style.transform = '';
      navBar2.style.transform = '';
    }
  }

  // Toggle & Close Events
  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileBtn.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  mobileCloseBtn?.addEventListener('click', closeDrawer);
  mobileBackdrop?.addEventListener('click', closeDrawer);

  mobileLinks.forEach(link => {
    link.addEventListener('click', closeDrawer);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDrawer();
    }
  });

  // Dynamic Scroll Elevation & Hero Reveal
  const siteHeader = document.getElementById('siteHeaderContainer');
  let lastScrollY = window.scrollY;
  function handleScroll() {
    const currentScrollY = window.scrollY;
    // Reveal sticky navbar when scrolled past the hero (~350px)
    if (currentScrollY > 350) {
      siteHeader?.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
      siteHeader?.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      mainHeader?.classList.add('shadow-md', 'shadow-slate-900/5', 'bg-white/95');
      mainHeader?.classList.remove('bg-white/90');
      navbarInner?.classList.remove('sm:py-4');
      navbarInner?.classList.add('sm:py-2.5');
    } else {
      siteHeader?.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
      siteHeader?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      mainHeader?.classList.remove('shadow-md', 'shadow-slate-900/5', 'bg-white/95');
      mainHeader?.classList.add('bg-white/90');
      navbarInner?.classList.remove('sm:py-2.5');
      navbarInner?.classList.add('sm:py-4');
    }
    lastScrollY = currentScrollY;
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>
