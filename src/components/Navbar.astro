---
// CleanMaster - Executive Textile Care Navbar
---

<!-- Sticky Top Nav Wrapper (Revealed on scroll past hero) -->
<div id="siteHeaderContainer" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 -translate-y-full opacity-0 pointer-events-none">

<!-- Announcement & Concierge Top Bar -->
<div id="topAnnouncementBar" class="w-full bg-slate-950 text-slate-300 text-[11px] sm:text-xs py-2 px-4 sm:px-8 border-b border-white/10 relative z-50">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
    
    <!-- Left: Coverage & Authority -->
    <div class="flex items-center gap-3 text-slate-400">
      <span class="inline-flex items-center gap-1.5 font-medium text-slate-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span>Lima Metropolitana & Alrededores</span>
      </span>
      <span class="hidden md:inline text-slate-700">•</span>
      <span class="hidden md:inline-flex items-center gap-1.5 text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>Inyección-Extracción Alemana & Vapor a 140°C</span>
      </span>
    </div>

    <!-- Right: Central Telefónica & Horarios -->
    <div class="flex items-center gap-4 text-slate-400">
      <span class="hidden lg:inline text-slate-400">
        Lun – Dom: 7:00 – 21:00 (Feriados incluidos)
      </span>
      <span class="hidden lg:inline text-slate-700">•</span>
      <a 
        href="tel:+51999999999" 
        class="inline-flex items-center gap-1.5 text-slate-200 hover:text-sky-400 font-semibold transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>Central: +51 999 999 999</span>
      </a>
    </div>

  </div>
</div>

<!-- Main Sticky Executive Header -->
<header id="mainHeader" class="sticky top-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border-b border-slate-200/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3.5 sm:py-4 flex items-center justify-between transition-all duration-300" id="navbarInner">
    
    <!-- Bespoke Brand Mark & Logotype -->
    <a href="#hero" class="flex items-center gap-3 group focus:outline-none" aria-label="CleanMaster Inicio">
      <!-- Bespoke Cleaning Tool Icon: Boquilla Extractora Textil & Vapor -->
      <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-sm group-hover:bg-sky-600 group-hover:shadow-md group-hover:shadow-sky-500/20 transition-all duration-300 relative overflow-hidden shrink-0 border border-slate-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-sky-400 group-hover:text-white transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <!-- Cabezal triangular de extracción para tapicería -->
          <path d="M3 19h18L16 11H8L3 19Z" fill="currentColor" fill-opacity="0.18" />
          <path d="M7 15h10" />
          <!-- Tubo de inyección y aspirado -->
          <path d="M12 11V3" />
          <!-- Mango y gatillo de inyección -->
          <path d="M9 3h6" />
          <path d="M12 6.5h3" />
          <!-- Chorros de vapor y succión profunda -->
          <path d="M5 22l-1 1" />
          <path d="M12 22v1.5" />
          <path d="M19 22l1 1" />
        </svg>
      </div>

      <div class="flex flex-col">
        <div class="flex items-baseline gap-1">
          <span class="font-display font-bold text-xl tracking-tight text-slate-950 group-hover:text-sky-600 transition-colors">
            Clean<span class="text-sky-600 group-hover:text-slate-950 transition-colors">Master</span>
          </span>
          <span class="text-[9px] font-semibold text-slate-400 tracking-wider">®</span>
        </div>
        <span class="text-[9px] tracking-[0.18em] text-slate-600 font-semibold uppercase leading-tight font-body-alt">
          Cuidado Textil & Muebles
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-[13px] font-semibold text-slate-700">
      
      <!-- Dropdown Servicios con Mega-Menu -->
      <div class="relative group" id="servicesDropdown">
        <button 
          type="button"
          class="px-3.5 py-2 rounded-lg text-slate-700 hover:text-sky-600 hover:bg-slate-50 transition-colors flex items-center gap-1.5 focus:outline-none"
          aria-expanded="false"
        >
          <span>Servicios</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-600 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Container con padding de seguridad para evitar parpadeos -->
        <div class="absolute top-full left-0 pt-2 w-[480px] opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/10 border border-slate-200/80 p-4 overflow-hidden">
            
            <div class="text-[11px] font-bold text-slate-600 uppercase tracking-wider px-2.5 pb-2 border-b border-slate-100">
              Tratamientos Especializados a Domicilio
            </div>

            <!-- Grid de Servicios con Iconografía Vectorial Limpia -->
            <div class="grid grid-cols-2 gap-2 pt-2.5">
              
              <!-- Servicio 1: Sofás -->
              <a href="#servicios" class="group/card flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 border border-sky-100 flex items-center justify-center shrink-0 group-hover/card:bg-sky-600 group-hover/card:text-white transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v3"/>
                    <path d="M2 11v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H6v-2a2 2 0 0 0-4 0Z"/>
                    <path d="M4 18v2"/>
                    <path d="M20 18v2"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-900 group-hover/card:text-sky-600 flex items-center gap-1.5">
                    <span>Sofás & Seccionales</span>
                  </div>
                  <p class="text-[11px] text-slate-500 line-clamp-2 mt-0.5 leading-snug">
                    Lino, microfibra, terciopelo y cuero con extracción profunda.
                  </p>
                </div>
              </a>

              <!-- Servicio 2: Colchones -->
              <a href="#servicios" class="group/card flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center shrink-0 group-hover/card:bg-emerald-600 group-hover/card:text-white transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 4v16"/>
                    <path d="M2 8h18a2 2 0 0 1 2 2v10"/>
                    <path d="M2 17h20"/>
                    <path d="M6 8v9"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-900 group-hover/card:text-sky-600 flex items-center gap-1.5">
                    <span>Colchones Antiácaros</span>
                  </div>
                  <p class="text-[11px] text-slate-500 line-clamp-2 mt-0.5 leading-snug">
                    Vapor a 140°C y luz germicida UV para higiene profunda.
                  </p>
                </div>
              </a>

              <!-- Servicio 3: Cortinas Roller -->
              <a href="#servicios" class="group/card flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 border border-amber-100 flex items-center justify-center shrink-0 group-hover/card:bg-amber-600 group-hover/card:text-white transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2"/>
                    <path d="M3 9h18"/>
                    <path d="M3 15h18"/>
                    <path d="M9 3v18"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-900 group-hover/card:text-sky-600 flex items-center gap-1.5">
                    <span>Cortinas & Estores</span>
                  </div>
                  <p class="text-[11px] text-slate-500 line-clamp-2 mt-0.5 leading-snug">
                    Tratamiento para blackout, sunscreen y paneles sin arrugas.
                  </p>
                </div>
              </a>

              <!-- Servicio 4: Sillas & Autos -->
              <a href="#servicios" class="group/card flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 border border-indigo-100 flex items-center justify-center shrink-0 group-hover/card:bg-indigo-600 group-hover/card:text-white transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 18v-6a5 5 0 1 1 10 0v6"/>
                    <path d="M5 18h14"/>
                    <path d="M6 18v4"/>
                    <path d="M18 18v4"/>
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-900 group-hover/card:text-sky-600 flex items-center gap-1.5">
                    <span>Sillas & Tapicería</span>
                  </div>
                  <p class="text-[11px] text-slate-500 line-clamp-2 mt-0.5 leading-snug">
                    Comedores, oficinas ejecutivas y asientos vehiculares.
                  </p>
                </div>
              </a>

            </div>

            <!-- Footer del Dropdown con Garantía Técnica -->
            <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] bg-slate-50 -mx-4 -mb-4 p-3 px-4">
              <span class="text-slate-500 flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Secado express en 2 a 3 horas</span>
              </span>
              <a href="#servicios" class="font-bold text-sky-600 hover:text-sky-700 inline-flex items-center gap-1 group/link">
                <span>Ver catálogo</span>
                <svg class="w-3 h-3 transition-transform group-hover/link:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>

          </div>
        </div>
      </div>

      <!-- Enlace: Resultados Reales -->
      <a href="#antes-despues" class="px-3.5 py-2 rounded-lg hover:text-sky-600 hover:bg-slate-50 transition-colors">
        Resultados
      </a>

      <!-- Enlace: El Proceso -->
      <a href="#proceso" class="px-3.5 py-2 rounded-lg hover:text-sky-600 hover:bg-slate-50 transition-colors">
        El Método
      </a>

      <!-- Enlace: Cotizador Interactivo -->
      <a href="#cotizador" class="px-3.5 py-2 rounded-lg hover:text-sky-600 hover:bg-slate-50 transition-colors inline-flex items-center gap-1.5">
        <span>Cotizador</span>
        <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-sky-50 text-sky-600 border border-sky-200/60">
          En vivo
        </span>
      </a>

      <!-- Enlace: FAQ -->
      <a href="#faq" class="px-3.5 py-2 rounded-lg hover:text-sky-600 hover:bg-slate-50 transition-colors">
        Preguntas
      </a>

    </nav>

    <!-- Right Actions / Conversion Desk -->
    <div class="flex items-center gap-3 sm:gap-4">
      
      <!-- Central Telefónica Compacta (Desktop) -->
      <div class="hidden xl:flex flex-col text-right">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-600 font-body-alt">
          Atención Hoy
        </span>
        <a href="tel:+51999999999" class="text-xs font-bold text-slate-800 hover:text-sky-600 transition-colors">
          +51 999 999 999
        </a>
      </div>

      <!-- Botón de Cotización Primario -->
      <a 
        href="https://wa.me/51999999999?text=Hola%20CleanMaster,%20deseo%20una%20cotizaci%C3%B3n%20para%20limpieza%20profesional" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-slate-900 hover:bg-sky-600 text-white font-medium text-xs sm:text-sm px-4 sm:px-5 py-2.5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-sky-600/20 active:scale-95 group"
      >
        <!-- WhatsApp Icon Minimalista -->
        <svg class="w-4 h-4 text-emerald-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Cotizar Servicio</span>
      </a>

      <!-- Botón Hamburguesa Moderno (Mobile) -->
      <button 
        id="mobileMenuBtn" 
        type="button"
        aria-label="Abrir menú" 
        aria-expanded="false"
        class="lg:hidden w-10 h-10 rounded-xl bg-slate-100 text-slate-800 flex flex-col items-center justify-center gap-1.5 hover:bg-slate-200 transition-colors focus:outline-none"
      >
        <span class="w-5 h-0.5 bg-slate-800 rounded-full transition-all duration-300 transform origin-center" id="navBar1"></span>
        <span class="w-5 h-0.5 bg-slate-800 rounded-full transition-all duration-300 transform origin-center" id="navBar2"></span>
      </button>

    </div>

  </div>
</header>
</div>

<!-- Mobile Navigation Drawer Overlay Backdrop -->
<div 
  id="mobileMenuBackdrop" 
  class="fixed inset-0 bg-slate-950/50 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Mobile Navigation Drawer Panel -->
<div 
  id="mobileMenuDrawer" 
  class="fixed top-0 right-0 bottom-0 w-[85%] max-w-sm bg-white z-50 shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Menú móvil"
>
  <!-- Drawer Header -->
  <div class="p-5 border-b border-slate-100 flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center border border-slate-800 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 19h18L16 11H8L3 19Z" fill="currentColor" fill-opacity="0.2" />
          <path d="M7 15h10" />
          <path d="M12 11V3" />
          <path d="M9 3h6" />
          <path d="M12 6.5h3" />
        </svg>
      </div>
      <span class="font-display font-bold text-lg tracking-tight text-slate-950">
        Clean<span class="text-sky-600">Master</span>
      </span>
    </div>

    <button 
      id="mobileMenuCloseBtn" 
      aria-label="Cerrar menú" 
      class="w-9 h-9 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200 flex items-center justify-center transition-colors focus:outline-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Body Navigation Links -->
  <div class="p-5 space-y-6 flex-1 overflow-y-auto">
    
    <!-- Categoría: Servicios -->
    <div>
      <div class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-2.5">
        Tratamientos Principales
      </div>
      <div class="grid grid-cols-1 gap-2">
        <a href="#servicios" class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-sky-50 text-slate-800 transition-colors">
          <div class="w-7 h-7 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v3"/><path d="M2 11v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H6v-2a2 2 0 0 0-4 0Z"/></svg>
          </div>
          <span class="text-xs font-bold">Sofás & Seccionales</span>
        </a>

        <a href="#servicios" class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-sky-50 text-slate-800 transition-colors">
          <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/></svg>
          </div>
          <span class="text-xs font-bold">Colchones Antiácaros</span>
        </a>

        <a href="#servicios" class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-sky-50 text-slate-800 transition-colors">
          <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 3v18"/></svg>
          </div>
          <span class="text-xs font-bold">Cortinas Roller & Estores</span>
        </a>

        <a href="#servicios" class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-sky-50 text-slate-800 transition-colors">
          <div class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 18v-6a5 5 0 1 1 10 0v6"/><path d="M5 18h14"/></svg>
          </div>
          <span class="text-xs font-bold">Sillas & Tapicería Automotriz</span>
        </a>
      </div>
    </div>

    <!-- Categoría: Navegación General -->
    <div>
      <div class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-2">
        Navegación
      </div>
      <div class="space-y-1 text-sm font-semibold text-slate-700">
        <a href="#hero" class="mobile-nav-link block px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-sky-600 transition-colors">
          Inicio
        </a>
        <a href="#antes-despues" class="mobile-nav-link block px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-sky-600 transition-colors">
          Casos de Éxito (Antes & Después)
        </a>
