---
---

<!-- Top Utility / Announcement Bar -->
<div class="w-full bg-slate-900 text-white text-[11px] sm:text-xs py-2 px-4 sm:px-8 border-b border-slate-800 relative z-50">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
    
    <!-- Left: Cobertura y Horarios -->
    <div class="flex items-center gap-4 text-slate-300">
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
        </svg>
        <span>Lima Metropolitana y Alrededores</span>
      </span>
      <span class="hidden md:inline text-slate-600">•</span>
      <span class="hidden md:flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
        </svg>
        <span>Lun - Dom: 7:00 AM – 9:00 PM (Feriados incluidos)</span>
      </span>
    </div>

    <!-- Right: Teléfono y Garantía -->
    <div class="flex items-center gap-5 text-slate-300">
      <span class="hidden lg:flex items-center gap-1 text-emerald-400 font-semibold">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>Garantía de Satisfacción 100%</span>
      </span>
      <a 
        href="tel:+51999999999" 
        class="hover:text-white font-display font-semibold transition-colors flex items-center gap-1.5 text-sky-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
        </svg>
        <span>Central: +51 999 999 999</span>
      </a>
    </div>

  </div>
</div>

<!-- Main Liquid Glass Sticky Navbar -->
<header class="sticky top-0 left-0 right-0 z-40 transition-all duration-300 bg-white/80 backdrop-blur-xl border-b border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)]" id="mainHeader">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3.5 flex items-center justify-between">
    
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-sky-600 to-sky-400 text-white flex items-center justify-center shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-display font-extrabold text-xl tracking-tight text-slate-900">
            Clean<span class="text-sky-600">Master</span>
          </span>
          <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
        </div>
        <span class="text-[9px] tracking-widest text-slate-400 font-semibold uppercase block -mt-1 font-body-alt">
          Cuidado Textil & Muebles S.A.C.
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 text-[13px] font-semibold text-slate-700">
      
      <a href="#hero" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-sky-600 transition-colors">
        Inicio
      </a>

      <!-- Dropdown Servicios -->
      <div class="relative group" id="servicesDropdown">
        <button class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-sky-600 transition-colors flex items-center gap-1.5 focus:outline-none">
          <span>Servicios</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-600 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div class="absolute top-full left-0 w-80 bg-white/95 backdrop-blur-2xl rounded-2xl shadow-2xl border border-slate-200/80 p-3 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200">
          <a href="#servicios" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-sky-50 transition-colors group/item">
            <span class="text-xl">🛋️</span>
            <div>
              <strong class="font-display text-xs text-slate-900 block group-hover/item:text-sky-600">Sofás y Muebles</strong>
              <span class="text-[11px] text-slate-500">Lino, terciopelo, microfibra</span>
            </div>
          </a>
          <a href="#servicios" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-sky-50 transition-colors group/item">
            <span class="text-xl">🪟</span>
            <div>
              <strong class="font-display text-xs text-slate-900 block group-hover/item:text-sky-600">Cortinas Roller & Estores</strong>
              <span class="text-[11px] text-slate-500">Blackout, screen y duo</span>
            </div>
          </a>
          <a href="#servicios" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-sky-50 transition-colors group/item">
            <span class="text-xl">🪑</span>
            <div>
              <strong class="font-display text-xs text-slate-900 block group-hover/item:text-sky-600">Sillas de Comedor & Oficina</strong>
              <span class="text-[11px] text-slate-500">Desmanchado textil</span>
            </div>
          </a>
          <a href="#servicios" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-sky-50 transition-colors group/item">
            <span class="text-xl">🛏️</span>
            <div>
              <strong class="font-display text-xs text-slate-900 block group-hover/item:text-sky-600">Colchones Antiácaros UV</strong>
              <span class="text-[11px] text-slate-500">Vapor 140°C y luz germicida</span>
            </div>
          </a>
        </div>
      </div>

      <a href="#antes-despues" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-sky-600 transition-colors">
        Evidencias
      </a>

      <a href="#proceso" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-sky-600 transition-colors">
        El Método
      </a>

      <a href="#cotizador" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-sky-600 transition-colors">
        Cotizador Online
      </a>

      <a href="#testimonios" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-sky-600 transition-colors">
        Opiniones
      </a>

      <a href="#faq" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-sky-600 transition-colors">
        Preguntas
      </a>

    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-3 sm:gap-4">
      
      <!-- Disponibilidad -->
      <div class="hidden xl:flex items-center gap-2 bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-full text-xs font-semibold border border-emerald-200/60 shadow-xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Técnicos Disponibles</span>
      </div>

      <!-- Botón WhatsApp -->
      <a 
        href="https://wa.me/51999999999?text=Hola%20CleanMaster,%20quisiera%20solicitar%20una%20cotizaci%C3%B3n" 
        target="_blank" 
        rel="noopener noreferrer"
        class="relative overflow-hidden bg-sky-600 hover:bg-sky-500 text-white font-display font-semibold text-xs sm:text-sm px-5 sm:px-6 py-2.5 rounded-full transition-all duration-300 shadow-md shadow-sky-600/25 hover:shadow-sky-600/40 hover:-translate-y-0.5 active:scale-95 flex items-center gap-2 group"
      >
        <span class="relative z-10">Cotizar Inmediato</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 relative z-10 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
      </a>

      <!-- Hamburguesa Móvil -->
      <button 
        id="mobileMenuBtn" 
        aria-label="Abrir Menú" 
        class="lg:hidden w-10 h-10 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center hover:bg-slate-200 transition-colors focus:outline-none"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobileMenuDrawer" 
    class="lg:hidden hidden bg-white/95 backdrop-blur-2xl border-t border-slate-200 p-6 space-y-4 shadow-2xl transition-all"
  >
    <div class="grid grid-cols-2 gap-3 text-sm font-display font-semibold text-slate-800">
      <a href="#hero" class="mobile-nav-link p-3 rounded-xl bg-slate-50 hover:bg-sky-50 block">Inicio</a>
      <a href="#servicios" class="mobile-nav-link p-3 rounded-xl bg-slate-50 hover:bg-sky-50 block">Servicios</a>
      <a href="#antes-despues" class="mobile-nav-link p-3 rounded-xl bg-slate-50 hover:bg-sky-50 block">Evidencias</a>
      <a href="#proceso" class="mobile-nav-link p-3 rounded-xl bg-slate-50 hover:bg-sky-50 block">El Método</a>
      <a href="#cotizador" class="mobile-nav-link p-3 rounded-xl bg-slate-50 hover:bg-sky-50 block">Cotizador</a>
      <a href="#testimonios" class="mobile-nav-link p-3 rounded-xl bg-slate-50 hover:bg-sky-50 block">Opiniones</a>
      <a href="#faq" class="mobile-nav-link p-3 rounded-xl bg-slate-50 hover:bg-sky-50 block col-span-2">Preguntas Frecuentes</a>
    </div>

    <div class="pt-2 border-t border-slate-100 flex flex-col gap-2">
      <a 
        href="https://wa.me/51999999999" 
        target="_blank" 
        class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 rounded-xl text-center text-sm shadow-md block"
      >
        Chatear por WhatsApp Directo
      </a>
      <a 
        href="tel:+51999999999" 
        class="w-full bg-slate-100 text-slate-800 font-bold py-2.5 rounded-xl text-center text-xs block"
      >
        Llamar a Central: +51 999 999 999
      </a>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileMenuDrawer');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', () => {
      mobileDrawer.classList.toggle('hidden');
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileDrawer.classList.add('hidden');
      });
    });
  }
</script>
