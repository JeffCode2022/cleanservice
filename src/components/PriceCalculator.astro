---
---

<section id="cotizador" class="full-bleed edge-pad py-24 relative overflow-hidden bg-slate-50">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-sky-100/50 via-transparent to-transparent -z-10"></div>
  
  <div class="max-w-7xl mx-auto">
    <div class="calc-header text-center mb-16">
      <h2 class="font-display text-4xl md:text-5xl text-slate-900 mb-4 clip-reveal">
        Calcula tu <span class="text-sky-600">Presupuesto</span>
      </h2>
      <p class="font-body text-slate-600 max-w-2xl mx-auto text-lg clip-reveal">
        Selecciona los servicios que necesitas y obtén un estimado al instante.
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-8 relative items-start">
      <!-- Left Column: Items (60%) -->
      <div class="w-full lg:w-[60%] flex flex-col gap-6 calc-items-container">
        
        <!-- Item 1 -->
        <div class="glass-card p-4 flex flex-col sm:flex-row gap-4 items-center sm:items-start calc-item group transition-all duration-300 hover:scale-[1.02] hover:shadow-lg rounded-2xl" data-id="sofa3" data-name="Sofá 3 Cuerpos" data-price="120" data-time="90">
          <img src="/images/service-sofa.jpg" alt="Sofá 3 Cuerpos" class="w-24 h-24 object-cover rounded-xl shadow-md group-hover:shadow-sky-200/50 transition-shadow">
          <div class="flex-1 text-center sm:text-left">
            <h3 class="font-display text-xl text-slate-900">Sofá 3 Cuerpos</h3>
            <p class="font-body text-sm text-slate-500 mb-2">Limpieza profunda y desmanchado</p>
            <div class="font-body-alt text-sky-600 font-semibold text-lg">S/ 120</div>
          </div>
          <div class="flex items-center gap-3 bg-slate-100 rounded-full px-4 py-2 mt-4 sm:mt-0 self-center">
            <button class="qty-btn minus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Disminuir cantidad">-</button>
            <span class="qty-val font-display w-6 text-center text-slate-900">0</span>
            <button class="qty-btn plus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="glass-card p-4 flex flex-col sm:flex-row gap-4 items-center sm:items-start calc-item group transition-all duration-300 hover:scale-[1.02] hover:shadow-lg rounded-2xl" data-id="sofasec" data-name="Sofá Seccional L" data-price="180" data-time="120">
          <img src="/images/service-sofa.jpg" alt="Sofá Seccional L" class="w-24 h-24 object-cover rounded-xl shadow-md group-hover:shadow-sky-200/50 transition-shadow">
          <div class="flex-1 text-center sm:text-left">
            <h3 class="font-display text-xl text-slate-900">Sofá Seccional en L</h3>
            <p class="font-body text-sm text-slate-500 mb-2">Tratamiento completo para seccionales</p>
            <div class="font-body-alt text-sky-600 font-semibold text-lg">S/ 180</div>
          </div>
          <div class="flex items-center gap-3 bg-slate-100 rounded-full px-4 py-2 mt-4 sm:mt-0 self-center">
            <button class="qty-btn minus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Disminuir cantidad">-</button>
            <span class="qty-val font-display w-6 text-center text-slate-900">0</span>
            <button class="qty-btn plus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="glass-card p-4 flex flex-col sm:flex-row gap-4 items-center sm:items-start calc-item group transition-all duration-300 hover:scale-[1.02] hover:shadow-lg rounded-2xl" data-id="sillas" data-name="Sillas de Comedor" data-price="15" data-time="20">
          <img src="/images/service-chairs.jpg" alt="Sillas de Comedor" class="w-24 h-24 object-cover rounded-xl shadow-md group-hover:shadow-sky-200/50 transition-shadow">
          <div class="flex-1 text-center sm:text-left">
            <h3 class="font-display text-xl text-slate-900">Sillas de Comedor</h3>
            <p class="font-body text-sm text-slate-500 mb-2">Limpieza de tapiz por unidad</p>
            <div class="font-body-alt text-sky-600 font-semibold text-lg">S/ 15 <span class="text-xs text-slate-400 font-normal">c/u</span></div>
          </div>
          <div class="flex items-center gap-3 bg-slate-100 rounded-full px-4 py-2 mt-4 sm:mt-0 self-center">
            <button class="qty-btn minus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Disminuir cantidad">-</button>
            <span class="qty-val font-display w-6 text-center text-slate-900">0</span>
            <button class="qty-btn plus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <!-- Item 4 -->
        <div class="glass-card p-4 flex flex-col sm:flex-row gap-4 items-center sm:items-start calc-item group transition-all duration-300 hover:scale-[1.02] hover:shadow-lg rounded-2xl" data-id="cortinas" data-name="Cortinas Roller" data-price="45" data-time="40">
          <img src="/images/service-curtains.jpg" alt="Cortinas Roller" class="w-24 h-24 object-cover rounded-xl shadow-md group-hover:shadow-sky-200/50 transition-shadow">
          <div class="flex-1 text-center sm:text-left">
            <h3 class="font-display text-xl text-slate-900">Cortinas Roller</h3>
            <p class="font-body text-sm text-slate-500 mb-2">Limpieza in situ, por unidad o paño</p>
            <div class="font-body-alt text-sky-600 font-semibold text-lg">S/ 45 <span class="text-xs text-slate-400 font-normal">c/u</span></div>
          </div>
          <div class="flex items-center gap-3 bg-slate-100 rounded-full px-4 py-2 mt-4 sm:mt-0 self-center">
            <button class="qty-btn minus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Disminuir cantidad">-</button>
            <span class="qty-val font-display w-6 text-center text-slate-900">0</span>
            <button class="qty-btn plus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <!-- Item 5 -->
        <div class="glass-card p-4 flex flex-col sm:flex-row gap-4 items-center sm:items-start calc-item group transition-all duration-300 hover:scale-[1.02] hover:shadow-lg rounded-2xl" data-id="colchon" data-name="Colchón Queen" data-price="110" data-time="80">
          <img src="/images/service-mattress.jpg" alt="Colchón Queen" class="w-24 h-24 object-cover rounded-xl shadow-md group-hover:shadow-sky-200/50 transition-shadow">
          <div class="flex-1 text-center sm:text-left">
            <h3 class="font-display text-xl text-slate-900">Colchón Queen/2 Plazas</h3>
            <p class="font-body text-sm text-slate-500 mb-2">Eliminación de ácaros y manchas</p>
            <div class="font-body-alt text-sky-600 font-semibold text-lg">S/ 110</div>
          </div>
          <div class="flex items-center gap-3 bg-slate-100 rounded-full px-4 py-2 mt-4 sm:mt-0 self-center">
            <button class="qty-btn minus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Disminuir cantidad">-</button>
            <span class="qty-val font-display w-6 text-center text-slate-900">0</span>
            <button class="qty-btn plus w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-600 hover:text-sky-600 hover:bg-sky-50 transition-colors shadow-sm" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>
        
        <!-- Add-ons -->
        <div class="mt-4 pt-6 border-t border-slate-200 calc-addons">
          <h4 class="font-display text-lg text-slate-800 mb-4">Adicionales recomendados</h4>
          <div class="flex flex-col sm:flex-row gap-4">
            <label class="flex-1 glass-card p-4 rounded-xl cursor-pointer hover:bg-sky-50/50 transition-colors flex items-start gap-3 border border-transparent hover:border-sky-100">
              <div class="relative flex items-start mt-1">
                <input type="checkbox" class="addon-checkbox peer w-5 h-5 accent-sky-600 rounded border-slate-300" data-name="Protección Anti-Manchas" data-price="40">
              </div>
              <div class="flex-1">
                <div class="font-display text-slate-900">Protección Anti-Manchas</div>
                <div class="text-xs text-slate-500 mt-1">Tratamiento protector repelente</div>
                <div class="text-sm font-semibold text-sky-600 mt-1">+ S/ 40</div>
              </div>
            </label>
            <label class="flex-1 glass-card p-4 rounded-xl cursor-pointer hover:bg-emerald-50/50 transition-colors flex items-start gap-3 border border-transparent hover:border-emerald-100">
              <div class="relative flex items-start mt-1">
                <input type="checkbox" class="addon-checkbox peer w-5 h-5 accent-emerald-500 rounded border-slate-300" data-name="Desinfección UV" data-price="25">
              </div>
              <div class="flex-1">
                <div class="font-display text-slate-900">Desinfección UV</div>
                <div class="text-xs text-slate-500 mt-1">Eliminación de virus y bacterias</div>
                <div class="text-sm font-semibold text-emerald-500 mt-1">+ S/ 25</div>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Column: Sticky Summary (40%) -->
      <div class="w-full lg:w-[40%] sticky top-24 calc-summary-container">
        <div class="glass-card rounded-3xl p-6 lg:p-8 bg-white/80 border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative overflow-hidden">
          
          <!-- Decorative bg elements inside card -->
          <div class="absolute -right-12 -top-12 w-40 h-40 bg-sky-100 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
          <div class="absolute -left-12 -bottom-12 w-40 h-40 bg-emerald-100 rounded-full blur-3xl opacity-30 pointer-events-none"></div>

          <h3 class="font-display text-2xl text-slate-900 mb-6 border-b border-slate-100 pb-4 relative z-10">Resumen de tu servicio</h3>
          
          <div class="space-y-4 mb-8 relative z-10" id="summary-items-list">
            <div class="text-slate-500 text-sm italic py-2 text-center" id="empty-state">Selecciona al menos un servicio para ver el resumen.</div>
            <!-- Dynamic items will go here -->
          </div>

          <div class="border-t border-slate-100 pt-6 space-y-3 relative z-10">
            <div class="flex justify-between items-center text-sm">
              <span class="font-body text-slate-500">Items seleccionados:</span>
              <span class="font-body-alt font-medium text-slate-900" id="total-count">0</span>
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class="font-body text-slate-500">Tiempo estimado:</span>
              <span class="font-body-alt font-medium text-slate-900" id="total-time">0 min</span>
            </div>
            
            <div class="flex justify-between items-end mt-4 pt-4 border-t border-slate-100">
              <span class="font-display text-lg text-slate-700">Total a Pagar</span>
              <div class="flex items-start">
                <span class="text-xl font-body-alt text-sky-600 font-medium mr-1 mt-1">S/</span>
                <span class="text-5xl font-display text-sky-600 tracking-tight" id="total-price">0</span>
              </div>
            </div>
          </div>

          <a href="#" id="whatsapp-cta" target="_blank" class="mt-8 block w-full py-4 px-6 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-center font-display text-lg font-medium shadow-[0_4px_14px_0_rgb(16,185,129,0.39)] hover:shadow-[0_6px_20px_rgba(16,185,129,0.23)] hover:-translate-y-1 transition-all duration-300 relative z-10 pointer-events-none opacity-50 flex items-center justify-center gap-2">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.81 11.81 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413Z"/>
            </svg>
            Agendar por WhatsApp
          </a>
          <p class="text-xs text-center text-slate-400 mt-3 relative z-10 font-body">Sin compromiso de pago, agendaremos tu visita</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Clip-path reveal for headings */
  .clip-reveal {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initPriceCalculator = () => {
    // GSAP Animations
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#cotizador",
        start: "top 75%",
        end: "bottom 80%",
        toggleActions: "play none none reverse"
      }
    });

    // Animate headers
    tl.fromTo(".clip-reveal", 
      { y: 50, opacity: 0, clipPath: 'polygon(0 0, 100% 0, 100% 0, 0 0)' },
      { y: 0, opacity: 1, clipPath: 'polygon(0 0, 100% 0, 100% 100%, 0% 100%)', duration: 0.8, stagger: 0.2, ease: "power3.out" }
    );

    // Stagger item cards
    tl.fromTo(".calc-item",
      { y: 40, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, stagger: 0.1, ease: "back.out(1.2)" },
      "-=0.4"
    );

    // Animate addons
    tl.fromTo(".calc-addons",
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, ease: "power2.out" },
      "-=0.2"
    );

    // Animate summary card
    tl.fromTo(".calc-summary-container",
      { x: 30, opacity: 0 },
      { x: 0, opacity: 1, duration: 0.8, ease: "power3.out" },
      "-=0.6"
    );

    // --- Calculator Logic ---
    const WA_NUMBER = "51999999999";
    const state = {
      items: {}, // id -> { qty, name, price, time }
      addons: [] // array of { name, price }
    };

    const emptyStateEl = document.getElementById('empty-state');
    const summaryListEl = document.getElementById('summary-items-list');
    const totalPriceEl = document.getElementById('total-price');
    const totalCountEl = document.getElementById('total-count');
    const totalTimeEl = document.getElementById('total-time');
    const whatsappBtn = document.getElementById('whatsapp-cta');

    // Setup minus/plus buttons
    document.querySelectorAll('.calc-item').forEach(card => {
      const id = card.dataset.id;
      const name = card.dataset.name;
      const price = parseFloat(card.dataset.price);
      const time = parseInt(card.dataset.time);
      
      const btnMinus = card.querySelector('.minus');
      const btnPlus = card.querySelector('.plus');
      const valDisplay = card.querySelector('.qty-val');

      state.items[id] = { qty: 0, name, price, time };

      btnMinus.addEventListener('click', () => {
        if (state.items[id].qty > 0) {
          state.items[id].qty--;
          valDisplay.textContent = state.items[id].qty;
          updateCalculator();
        }
      });

      btnPlus.addEventListener('click', () => {
        state.items[id].qty++;
        valDisplay.textContent = state.items[id].qty;
        updateCalculator();
      });
    });

    // Setup addons
    document.querySelectorAll('.addon-checkbox').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const name = e.target.dataset.name;
        const price = parseFloat(e.target.dataset.price);
        
        if (e.target.checked) {
          state.addons.push({ name, price });
        } else {
          state.addons = state.addons.filter(a => a.name !== name);
        }
        updateCalculator();
      });
    });

    function updateCalculator() {
      let total = 0;
      let count = 0;
      let time = 0;
      let summaryHTML = '';

      // Items
      for (const id in state.items) {
        const item = state.items[id];
        if (item.qty > 0) {
          const itemTotal = item.qty * item.price;
          total += itemTotal;
          count += item.qty;
          time += item.qty * item.time;
          
          summaryHTML += `
            <div class="flex justify-between items-start text-sm">
              <div class="flex flex-col">
                <span class="font-display text-slate-800">${item.name} <span class="text-slate-400 font-body text-xs">x${item.qty}</span></span>
              </div>
              <span class="font-body-alt font-medium text-slate-900">S/ ${itemTotal.toFixed(2)}</span>
            </div>
          `;
        }
      }

      // Addons
      if (count > 0 && state.addons.length > 0) {
        summaryHTML += `<div class="w-full h-px bg-slate-100 my-2"></div>`;
        state.addons.forEach(addon => {
          total += addon.price;
          summaryHTML += `
            <div class="flex justify-between items-start text-sm">
              <div class="flex flex-col">
                <span class="font-display text-emerald-600 text-xs uppercase tracking-wide">Extra</span>
                <span class="font-body text-slate-700">${addon.name}</span>
              </div>
              <span class="font-body-alt font-medium text-slate-900">S/ ${addon.price.toFixed(2)}</span>
            </div>
          `;
        });
      }

      if (count > 0) {
        emptyStateEl.style.display = 'none';
        summaryListEl.innerHTML = summaryHTML;
        
        // Enable WA button
        whatsappBtn.classList.remove('pointer-events-none', 'opacity-50');
        
        // Update values with animation
        animateValue(totalPriceEl, parseFloat(totalPriceEl.textContent), total, 500);
        totalCountEl.textContent = count;
        
        // Format time
        const hours = Math.floor(time / 60);
        const mins = time % 60;
        totalTimeEl.textContent = hours > 0 ? `${hours}h ${mins}m` : `${mins} min`;

        generateWhatsAppLink(total, count);

      } else {
        emptyStateEl.style.display = 'block';
        summaryListEl.innerHTML = '';
        summaryListEl.appendChild(emptyStateEl);
        
        whatsappBtn.classList.add('pointer-events-none', 'opacity-50');
        
        totalPriceEl.textContent = '0';
        totalCountEl.textContent = '0';
        totalTimeEl.textContent = '0 min';
        whatsappBtn.href = '#';
      }
    }

    function animateValue(obj, start, end, duration) {
      if (start === end) return;
      
      const timeline = gsap.timeline();
      
      // Flash effect on total
      timeline.to(obj, {
        scale: 1.1,
        color: '#0284C7',
        duration: 0.1,
        onStart: () => {
          let startTimestamp = null;
          const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            obj.innerHTML = (progress * (end - start) + start).toFixed(2);
            if (progress < 1) {
              window.requestAnimationFrame(step);
            } else {
              obj.innerHTML = end.toFixed(2);
            }
          };
          window.requestAnimationFrame(step);
        }
      }).to(obj, {
        scale: 1,
        duration: 0.3,
        ease: "back.out(2)"
      });
    }

    function generateWhatsAppLink(total, count) {
      let msg = `¡Hola CleanMaster! 👋\nMe gustaría agendar un servicio. Aquí está mi cotización:\n\n*SERVICIOS:*\n`;
      
      for (const id in state.items) {
        const item = state.items[id];
        if (item.qty > 0) {
          msg += `- ${item.qty}x ${item.name} (S/ ${item.qty * item.price})\n`;
        }
      }

      if (state.addons.length > 0) {
        msg += `\n*ADICIONALES:*\n`;
        state.addons.forEach(addon => {
          msg += `- ${addon.name} (+S/ ${addon.price})\n`;
        });
      }

      msg += `\n*TOTAL ESTIMADO: S/ ${total.toFixed(2)}*\n\n¿Qué disponibilidad tienen?`;

      const encodedMsg = encodeURIComponent(msg);
      if (whatsappBtn) {
        (whatsappBtn as HTMLAnchorElement).href = `https://wa.me/${WA_NUMBER}?text=${encodedMsg}`;
      }
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPriceCalculator);
  } else {
    initPriceCalculator();
  }
</script>
