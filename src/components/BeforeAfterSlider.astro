---
---

<section id="antes-despues" class="full-bleed edge-pad py-24 bg-white relative overflow-hidden">
  <div class="max-w-6xl mx-auto text-center mb-12">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-card border border-slate-200/80 text-xs font-semibold text-sky-700 mb-3 shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
      <span>Transformación en Tiempo Real</span>
    </div>
    <h2 class="font-display text-4xl sm:text-5xl font-bold text-slate-900 mb-4 tracking-tight">
      Resultados Reales: <span class="text-sky-600">Antes vs Después</span>
    </h2>
    <p class="font-body text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
      Desliza la barra central para ver cómo nuestra tecnología de inyección-succión disuelve derrames de café, polvo y grasa profunda de las fibras.
    </p>
  </div>

  <div class="max-w-5xl mx-auto relative rounded-3xl overflow-hidden aspect-[16/10] sm:aspect-[16/9] select-none slider-container shadow-2xl border border-slate-200/80">
    
    <!-- Capa Inferior: ANTES (Sofá con manchas reales y suciedad) -->
    <div class="absolute inset-0 w-full h-full bg-slate-100">
      <img 
        src="/images/sofa-dirty-full.jpg" 
        alt="Sofá antes de la limpieza con manchas" 
        class="absolute inset-0 w-full h-full object-cover" 
        draggable="false"
      />
      <div class="absolute top-5 left-5 bg-slate-900/85 backdrop-blur-md text-white px-4 py-1.5 rounded-full font-bold font-body-alt text-xs shadow-lg pointer-events-none z-10 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-red-400"></span>
        <span>ANTES DEL SERVICIO</span>
      </div>
    </div>

    <!-- Capa Superior: DESPUÉS (Sofá 100% limpio y renovado) con clip-path dinámico -->
    <div 
      class="absolute inset-0 w-full h-full clip-layer z-10 pointer-events-none" 
      style="clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);"
    >
      <img 
        src="/images/sofa-clean-full.jpg" 
        alt="Sofá después de la limpieza completamente limpio" 
        class="absolute inset-0 w-full h-full object-cover" 
        draggable="false"
      />
      <div class="absolute top-5 right-5 bg-emerald-600/90 backdrop-blur-md text-white px-4 py-1.5 rounded-full font-bold font-body-alt text-xs shadow-lg pointer-events-none z-20 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
        <span>DESPUÉS (100% LIMPIO)</span>
      </div>
    </div>

    <!-- Barra Divisora Deslizable -->
    <div 
      class="absolute top-0 bottom-0 w-1 bg-white cursor-ew-resize z-30 divider-line left-[50%] -ml-[2px] shadow-[0_0_15px_rgba(0,0,0,0.45)]"
      id="sliderDivider"
    >
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-11 h-11 bg-white rounded-full shadow-2xl flex items-center justify-center text-sky-600 border-2 border-sky-500 divider-handle pointer-events-none transition-transform active:scale-95 hover:scale-110">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 9l-4 4 4 4m8-8l4 4-4 4" />
        </svg>
      </div>
    </div>

    <!-- Indicador Flotante Inferior -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 pointer-events-none bg-slate-900/75 backdrop-blur-md text-white text-xs font-semibold px-4 py-1.5 rounded-full shadow-lg z-20">
      ↔ Arrastra para comparar
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const container = document.querySelector('.slider-container');
  const clipLayer = document.querySelector('.clip-layer') as HTMLElement;
  const divider = document.getElementById('sliderDivider') as HTMLElement;

  if (container && clipLayer && divider) {
    // Animación de demostración al entrar en pantalla con ScrollTrigger
    gsap.fromTo(divider, 
      { left: '75%' }, 
      {
        left: '35%',
        duration: 1.4,
        ease: "power2.inOut",
        scrollTrigger: {
          trigger: container,
          start: "top 75%",
          once: true
        },
        onUpdate: function() {
          const leftVal = divider.style.left;
          clipLayer.style.clipPath = `polygon(${leftVal} 0, 100% 0, 100% 100%, ${leftVal} 100%)`;
        }
      }
    );

    let isDragging = false;

    const setPosition = (clientX: number) => {
      const rect = container.getBoundingClientRect();
      let x = clientX - rect.left;
      if (x < 0) x = 0;
      if (x > rect.width) x = rect.width;
      const percentage = (x / rect.width) * 100;
      divider.style.left = `${percentage}%`;
      clipLayer.style.clipPath = `polygon(${percentage}% 0, 100% 0, 100% 100%, ${percentage}% 100%)`;
    };

    divider.addEventListener('mousedown', () => { isDragging = true; });
    container.addEventListener('mousedown', (e: any) => {
      isDragging = true;
      setPosition(e.clientX);
    });

    divider.addEventListener('touchstart', () => { isDragging = true; }, { passive: true });
    container.addEventListener('touchstart', (e: any) => {
      isDragging = true;
      setPosition(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('mouseup', () => { isDragging = false; });
    window.addEventListener('touchend', () => { isDragging = false; });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDragging) return;
      setPosition(e.clientX);
    });

    window.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging) return;
      setPosition(e.touches[0].clientX);
    }, { passive: true });
  }
</script>
