---
---
<section id="servicios" class="services-section full-bleed edge-pad py-20 bg-slate-50/50">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-display text-slate-900 mb-4">Nuestros <span class="text-sky-600">Servicios</span></h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">Especialistas en limpieza profunda y desinfección para cada rincón de tu hogar, garantizando un ambiente bio-seguro.</p>
    </div>

    <div class="bento-grid perspective-container">
      
      <!-- Card 1: Sofás -->
      <div class="bento-item item-sofa tilt-card glass-card overflow-hidden flex flex-col group">
        <div class="relative overflow-hidden h-64 md:h-80 w-full">
          <div class="w-full h-full parallax-wrapper">
             <img src="/images/service-sofa.jpg" alt="Limpieza de Sofás" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          </div>
        </div>
        <div class="p-6 md:p-8 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="text-2xl font-display text-slate-900 mb-2">Limpieza de Sofás</h3>
            <p class="text-slate-600 mb-4">Renovación total para tus muebles. Eliminación de manchas, ácaros y malos olores con tecnología bio-segura.</p>
          </div>
          <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-200/50">
            <span class="text-emerald-500 font-bold font-body-alt text-lg">Desde S/ 120</span>
            <a href="https://wa.me/51999999999?text=Hola,%20deseo%20cotizar%20la%20limpieza%20de%20sofás" target="_blank" rel="noopener noreferrer" class="text-sky-600 hover:text-sky-700 font-medium transition-colors">Cotizar →</a>
          </div>
        </div>
      </div>

      <!-- Card 2: Cortinas -->
      <div class="bento-item item-cortinas tilt-card glass-card overflow-hidden flex flex-col group">
        <div class="relative overflow-hidden h-48 w-full">
          <div class="w-full h-full parallax-wrapper">
             <img src="/images/service-curtains.jpg" alt="Limpieza de Cortinas" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-display text-slate-900 mb-2">Cortinas y Rollers</h3>
            <p class="text-slate-600 mb-4 text-sm">Lavado in situ. Eliminamos polvo acumulado sin necesidad de desmontar.</p>
          </div>
          <div class="flex items-center justify-between mt-2">
            <span class="text-emerald-500 font-bold font-body-alt">Desde S/ 80</span>
            <a href="https://wa.me/51999999999?text=Hola,%20deseo%20cotizar%20la%20limpieza%20de%20cortinas" target="_blank" rel="noopener noreferrer" class="text-sky-600 hover:text-sky-700 font-medium transition-colors text-sm">Cotizar →</a>
          </div>
        </div>
      </div>

      <!-- Card 3: Sillas -->
      <div class="bento-item item-sillas tilt-card glass-card overflow-hidden flex flex-col group">
        <div class="relative overflow-hidden h-48 w-full">
          <div class="w-full h-full parallax-wrapper">
             <img src="/images/service-chairs.jpg" alt="Limpieza de Sillas" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-display text-slate-900 mb-2">Sillas de Comedor</h3>
            <p class="text-slate-600 mb-4 text-sm">Tratamiento especial para tapices delicados. Secado ultra rápido.</p>
          </div>
          <div class="flex items-center justify-between mt-2">
            <span class="text-emerald-500 font-bold font-body-alt">Desde S/ 25</span>
            <a href="https://wa.me/51999999999?text=Hola,%20deseo%20cotizar%20la%20limpieza%20de%20sillas" target="_blank" rel="noopener noreferrer" class="text-sky-600 hover:text-sky-700 font-medium transition-colors text-sm">Cotizar →</a>
          </div>
        </div>
      </div>

      <!-- Card 4: Colchones -->
      <div class="bento-item item-colchones tilt-card glass-card overflow-hidden flex flex-col sm:flex-row group">
        <div class="relative overflow-hidden h-48 sm:h-full sm:w-2/5">
          <div class="w-full h-full parallax-wrapper">
             <img src="/images/service-mattress.jpg" alt="Limpieza de Colchones" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          </div>
        </div>
        <div class="p-6 md:p-8 flex-1 flex flex-col justify-between sm:w-3/5">
          <div>
            <h3 class="text-2xl font-display text-slate-900 mb-2">Desinfección de Colchones</h3>
            <p class="text-slate-600 mb-4">Mejora tu calidad de sueño. Extraemos ácaros, piel muerta y fluidos corporales garantizando un descanso saludable.</p>
          </div>
          <div class="flex items-center justify-between mt-4">
            <span class="text-emerald-500 font-bold font-body-alt text-lg">Desde S/ 90</span>
            <a href="https://wa.me/51999999999?text=Hola,%20deseo%20cotizar%20la%20limpieza%20de%20colchones" target="_blank" rel="noopener noreferrer" class="text-sky-600 hover:text-sky-700 font-medium transition-colors">Cotizar →</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .perspective-container {
    perspective: 1200px;
  }
  
  .bento-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      grid-template-areas: 
        "sofa sofa cortinas"
        "sofa sofa sillas"
        "colchones colchones colchones";
    }
    
    .item-sofa { grid-area: sofa; }
    .item-cortinas { grid-area: cortinas; }
    .item-sillas { grid-area: sillas; }
    .item-colchones { grid-area: colchones; }
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, minmax(200px, auto));
      grid-template-areas: 
        "sofa sofa cortinas sillas"
        "sofa sofa colchones colchones";
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // 3D Card Animation
  const cards = document.querySelectorAll(".bento-item");
  if (cards.length > 0) {
    gsap.fromTo(cards, 
      { 
        y: 80,
        rotationX: 10,
        rotationY: -10,
        opacity: 0,
        transformOrigin: "50% 50% -50px"
      },
      {
        y: 0,
        rotationX: 0,
        rotationY: 0,
        opacity: 1,
        duration: 1.2,
        stagger: 0.15,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".services-section",
          start: "top 75%",
        }
      }
    );
  }

  // Subtle Parallax for images
  const parallaxWrappers = document.querySelectorAll(".parallax-wrapper");
  parallaxWrappers.forEach(wrapper => {
    // scale up slightly so it has room to parallax without showing edges
    gsap.set(wrapper, { scale: 1.15 });
    gsap.to(wrapper, {
      yPercent: 12,
      ease: "none",
      scrollTrigger: {
        trigger: wrapper.closest('.bento-item'),
        start: "top bottom",
        end: "bottom top",
        scrub: true
      }
    });
  });
</script>
