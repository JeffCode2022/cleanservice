---
---
<section class="stats-section full-bleed edge-pad py-16">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 perspective-container">
    <div class="stat-card glass-card p-6 text-center transform-style-3d">
      <div class="text-4xl md:text-5xl font-display text-sky-600 mb-2 font-bold"><span class="stat-number" data-target="5200">0</span><span class="text-3xl">+</span></div>
      <div class="text-emerald-500 font-bold mb-1 font-body-alt">Muebles Recuperados</div>
      <p class="text-sm text-slate-600">Devolviendo vida a tus espacios</p>
    </div>
    
    <div class="stat-card glass-card p-6 text-center transform-style-3d">
      <div class="text-4xl md:text-5xl font-display text-sky-600 mb-2 font-bold"><span class="stat-number" data-target="99.8">0</span><span class="text-3xl">%</span></div>
      <div class="text-emerald-500 font-bold mb-1 font-body-alt">Satisfacción</div>
      <p class="text-sm text-slate-600">Clientes felices nos respaldan</p>
    </div>

    <div class="stat-card glass-card p-6 text-center transform-style-3d">
      <div class="text-4xl md:text-5xl font-display text-sky-600 mb-2 font-bold"><span class="stat-number" data-target="2">0</span><span class="text-3xl">h</span></div>
      <div class="text-emerald-500 font-bold mb-1 font-body-alt">Secado Express</div>
      <p class="text-sm text-slate-600">Listo para usar rápidamente</p>
    </div>

    <div class="stat-card glass-card p-6 text-center transform-style-3d">
      <div class="text-4xl md:text-5xl font-display text-sky-600 mb-2 font-bold"><span class="stat-number" data-target="100">0</span><span class="text-3xl">%</span></div>
      <div class="text-emerald-500 font-bold mb-1 font-body-alt">Bio-Seguro</div>
      <p class="text-sm text-slate-600">Productos amigables y seguros</p>
    </div>
  </div>
</section>

<style>
  .perspective-container {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initStatsBar = () => {
    const cards = document.querySelectorAll(".stat-card");
    
    if (cards.length > 0) {
      // 3D Flip Reveal
      gsap.fromTo(cards, 
        { rotationX: 90, opacity: 0, transformOrigin: "50% 50% -100px" },
        {
          rotationX: 0,
          opacity: 1,
          duration: 1.2,
          stagger: 0.15,
          ease: "expo.out",
          scrollTrigger: {
            trigger: ".stats-section",
            start: "top 85%",
            once: true
          }
        }
      );

      // Counter Animation
      const stats = document.querySelectorAll(".stat-number");
      stats.forEach(stat => {
        const target = parseFloat(stat.getAttribute("data-target") || "0");
        const isDecimal = target % 1 !== 0;
        const counter = { val: 0 };
        
        gsap.to(counter, {
          val: target,
          duration: 2.2,
          ease: "power3.out",
          scrollTrigger: {
            trigger: ".stats-section",
            start: "top 85%",
            once: true
          },
          onUpdate: function() {
            if (isDecimal) {
              stat.innerHTML = counter.val.toFixed(1);
            } else {
              stat.innerHTML = Math.round(counter.val).toLocaleString('en-US');
            }
          }
        });
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatsBar);
  } else {
    initStatsBar();
  }
</script>
